# ==== MongoDB Atlas ====
# Paste your MongoDB Atlas connection string here.
MONGODB_URI=

# ==== Auth ====
# Admin login for the dashboard. Change these to your own values in .env.local
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me

# Secret used to sign login sessions (use a long random string)
JWT_SECRET=change_this_to_a_long_random_secret_string
